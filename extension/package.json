{
  "name": "beyim-solver-extension",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Beyim Solver WebExtension for Chrome and Safari",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "node scripts/build.mjs && node scripts/package.mjs",
    "package:beta": "node scripts/build.mjs --beta && node scripts/package.mjs --beta",
    "build:safari": "node scripts/build.mjs --safari --server",
    "package:safari:server": "node scripts/build.mjs --safari --server && node scripts/package.mjs --safari --server",
    "package:safari": "node scripts/build.mjs --safari --server && node scripts/package.mjs --safari --server",
    "package:safari:groq": "node scripts/build.mjs --safari && node scripts/package.mjs --safari"
  },
  "dependencies": {
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/webextension-polyfill": "^0.12.1",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "typescript": "^5.7.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
