{
  "manifest_version": 3,
  "name": "Beyim Solver",
  "version": "0.1.0",
  "description": "Решает задания Beyim через локальный API и Groq.",
  "permissions": ["activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://beyim.ai/*",
    "https://*.beyim.ai/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Beyim Solver"
  },
  "content_scripts": [
    {
      "matches": ["https://beyim.ai/*", "https://*.beyim.ai/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
